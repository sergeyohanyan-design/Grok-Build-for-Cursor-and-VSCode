{
  "name": "grok-build-gui",
  "displayName": "Grok Build GUI",
  "description": "Enhanced Grok Build GUI: VS Code sidebar for the Grok CLI (ACP) with working Windows System.Speech voice, chat copy/paste/undo, screenshot vision, and Windows file-attach fixes. Not affiliated with xAI.",
  "version": "1.0.5",
  "publisher": "sahilrakhaiya",
  "author": {
    "name": "Sahil Rakhaiya"
  },
  "license": "MIT",
  "homepage": "https://github.com/sergeyohanyan-design/Grok-Build-GUI",
  "repository": {
    "type": "git",
    "url": "https://github.com/sergeyohanyan-design/Grok-Build-GUI.git"
  },
  "bugs": {
    "url": "https://github.com/sergeyohanyan-design/Grok-Build-GUI/issues"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "agent",
    "sidebar",
    "developer-tools",
    "acp"
  ],
  "icon": "resources/grok-icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:grok.chat",
    "onCommand:grok.open",
    "onCommand:grok.uploadFile"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "grokSidebar",
          "title": "Grok Build GUI",
          "icon": "resources/grok-icon.svg"
        }
      ],
      "secondarySideBar": [
        {
          "id": "grokSidebar",
          "title": "Grok Build GUI",
          "icon": "resources/grok-icon.svg"
        }
      ]
    },
    "views": {
      "grokSidebar": [
        {
          "type": "webview",
          "id": "grok.chat",
          "name": "Grok Build GUI"
        }
      ]
    },
    "commands": [
      {
        "command": "grok.open",
        "title": "Open Grok Build GUI",
        "icon": {
          "light": "resources/grok-icon-dark.svg",
          "dark": "resources/grok-icon-light.svg"
        }
      },
      {
        "command": "grok.uploadFile",
        "title": "Grok: Upload Files",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "grok.attachActiveFile",
        "title": "Grok: Attach Active File",
        "icon": "$(file)"
      },
      {
        "command": "grok.newSession",
        "title": "Grok: New Session"
      },
      {
        "command": "grok.compact",
        "title": "Grok: Compact Conversation"
      },
      {
        "command": "grok.pickModel",
        "title": "Grok: Pick Model"
      },
      {
        "command": "grok.toggleMode",
        "title": "Grok: Toggle Plan / Agent Mode"
      },
      {
        "command": "grok.sendSelection",
        "title": "Grok: Send Selection"
      },
      {
        "command": "grok.sendFile",
        "title": "Grok: Send File"
      },
      {
        "command": "grok.insertAtMention",
        "title": "Grok: Insert @-Mention"
      },
      {
        "command": "grok.showLogs",
        "title": "Grok: Show Logs"
      },
      {
        "command": "grok.logout",
        "title": "Grok: Log Out"
      },
      {
        "command": "grok.chatCopy",
        "title": "Grok: Copy (Chat)"
      },
      {
        "command": "grok.chatPaste",
        "title": "Grok: Paste (Chat)"
      },
      {
        "command": "grok.chatCut",
        "title": "Grok: Cut (Chat)"
      },
      {
        "command": "grok.chatSelectAll",
        "title": "Grok: Select All (Chat)"
      },
      {
        "command": "grok.chatUndo",
        "title": "Grok: Undo (Chat)"
      },
      {
        "command": "grok.chatRedo",
        "title": "Grok: Redo (Chat)"
      }
    ],
    "keybindings": [
      {
        "command": "grok.open",
        "key": "ctrl+;",
        "mac": "cmd+;"
      },
      {
        "command": "grok.insertAtMention",
        "key": "alt+g",
        "when": "editorTextFocus"
      },
      {
        "command": "grok.chatCopy",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "focusedView == 'grok.chat' || grok.chatFocus"
      },
      {
        "command": "grok.chatPaste",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "focusedView == 'grok.chat' || grok.chatFocus"
      },
      {
        "command": "grok.chatCut",
        "key": "ctrl+x",
        "mac": "cmd+x",
        "when": "focusedView == 'grok.chat' || grok.chatFocus"
      },
      {
        "command": "grok.chatSelectAll",
        "key": "ctrl+a",
        "mac": "cmd+a",
        "when": "focusedView == 'grok.chat' || grok.chatFocus"
      },
      {
        "command": "grok.chatUndo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "focusedView == 'grok.chat' || grok.chatFocus"
      },
      {
        "command": "grok.chatRedo",
        "key": "ctrl+y",
        "mac": "cmd+shift+z",
        "when": "focusedView == 'grok.chat' || grok.chatFocus"
      },
      {
        "command": "grok.chatRedo",
        "key": "ctrl+shift+z",
        "mac": "cmd+shift+z",
        "when": "focusedView == 'grok.chat' || grok.chatFocus"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "grok.open",
          "group": "navigation@97",
          "when": "true"
        },
        {
          "command": "grok.uploadFile",
          "group": "navigation@98",
          "when": "true"
        }
      ],
      "editor/context": [
        {
          "command": "grok.sendSelection",
          "when": "editorHasSelection",
          "group": "grok@1"
        }
      ],
      "explorer/context": [
        {
          "command": "grok.sendFile",
          "when": "resourceScheme == file",
          "group": "grok@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "grok.sendFile",
          "when": "resourceScheme == file",
          "group": "grok@1"
        }
      ]
    },
    "configuration": {
      "title": "Grok",
      "properties": {
        "grok.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the grok binary. Empty = auto-discover (~/.grok/bin/grok, then PATH)."
        },
        "grok.defaultModel": {
          "type": "string",
          "default": "",
          "description": "Model ID to use on new sessions. Empty = CLI default."
        },
        "grok.includeActiveFileByDefault": {
          "type": "boolean",
          "default": true,
          "description": "Auto-add the active editor file as a context chip."
        },
        "grok.defaultEffort": {
          "type": "string",
          "enum": [
            "",
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "enumDescriptions": [
            "CLI default (no flag passed to grok agent stdio)",
            "None",
            "Minimal",
            "Low — faster, lighter reasoning",
            "Medium",
            "High",
            "XHigh — deepest reasoning, slowest"
          ],
          "default": "",
          "description": "Reasoning effort passed as --reasoning-effort to grok agent stdio. Values match the grok CLI's accepted set (none, minimal, low, medium, high, xhigh). Changing this restarts the session."
        },
        "grok.useCtrlEnterToSend": {
          "type": "boolean",
          "default": false,
          "description": "Use Ctrl/Cmd+Enter to send (Enter inserts newline)."
        },
        "grok.autoOpenSecondarySidebar": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open Grok in the secondary sidebar (right panel) when VS Code starts."
        },
        "grok.autoUpdateCliOnUpgrade": {
          "type": "boolean",
          "default": false,
          "description": "Silently run grok update when the extension version changes. Disabled by default to avoid slow startups."
        },
        "grok.voiceEngine": {
          "type": "string",
          "enum": ["auto", "windows", "xai"],
          "default": "auto",
          "description": "Voice STT backend. auto = Windows System.Speech on Windows (no API key/ffmpeg), otherwise xAI cloud STT. windows = force System.Speech. xai = force xAI STT + ffmpeg."
        },
        "grok.voiceTts": {
          "type": "boolean",
          "default": true,
          "description": "After a voice-submitted message, speak the agent reply with Windows SAPI TTS (Windows only)."
        },
        "grok.voiceApiKey": {
          "type": "string",
          "default": "",
          "description": "xAI API key for Speech-to-Text voice input (console.x.ai). Only needed when grok.voiceEngine is xai (or auto on non-Windows). Falls back to GROK_VOICE_API_KEY or XAI_API_KEY env vars."
        },
        "grok.ffmpegPath": {
          "type": "string",
          "default": "",
          "description": "Path to the ffmpeg binary used for microphone capture (xAI STT engine only). Empty = 'ffmpeg' on PATH."
        },
        "grok.voiceInputDevice": {
          "type": "string",
          "default": "",
          "description": "Microphone device name for xAI/ffmpeg capture. On Windows this must be a DirectShow audio device name (dshow has no 'default'). Empty = auto-pick first device. Unused for Windows System.Speech (uses default mic)."
        },
        "grok.voiceSendPhrase": {
          "type": "string",
          "default": "grok send",
          "description": "Trailing voice phrase that submits the composer (hands-free). Empty disables. Default: 'grok send'."
        },
        "grok.voiceStreaming": {
          "type": "boolean",
          "default": true,
          "description": "xAI engine only: use realtime WebSocket STT (live partials + hands-free 'grok send'). When false, record then batch-transcribe on mic stop. Windows engine always streams partials."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node scripts/bundle.cjs",
    "package:fork": "node scripts/package-fork-vsix.cjs",
    "bundle": "node scripts/bundle.cjs",
    "bundle:dev": "node -e \"process.env.MARKETPLACE_BUNDLE='0'; require('./scripts/bundle.cjs')\"",
    "compile": "tsc -p .",
    "watch": "tsc -p . -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "tsc -p . && node scripts/live-tests.cjs",
    "prepackage": "node -e \"for (const f of require('fs').readdirSync('.')) if (f.endsWith('.vsix')) require('fs').unlinkSync(f)\" && node scripts/prepare-marketplace-package.cjs && node scripts/check-marketplace-readme.cjs",
    "postpackage": "node scripts/restore-marketplace-package.cjs",
    "package": "node scripts/package-vsix.cjs",
    "publish": "npx @vscode/vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.94.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "happy-dom": "^20.9.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
